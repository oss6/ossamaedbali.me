{
  "name": "ossamaedbali.me",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "aws s3 sync build/ s3://ossamaedbali.me",
    "release": "commit-and-tag-version",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "commit-and-tag-version": {
    "scripts": {
      "posttag": "git push --follow-tags origin master"
    },
    "commitUrlFormat": "https://github.com/oss6/ossamaedbali.me/commit/{{hash}}",
    "compareUrlFormat": "https://github.com/oss6/ossamaedbali.me/compare/{{previousTag}}...{{currentTag}}",
    "issueUrlFormat": "https://github.com/oss6/ossamaedbali.me/issues/{{id}}"
  },
  "dependencies": {
    "@portabletext/react": "^8.0.1",
    "@sanity/client": "^8.9.0",
    "@sanity/image-url": "^2.1.1",
    "date-fns": "^4.4.0",
    "katex": "^0.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-loading-skeleton": "^3.5.0",
    "react-router": "^8.4.0",
    "react-syntax-highlighter": "^16.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "commit-and-tag-version": "^13.3.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "repository": "https://github.com/oss6/ossamaedbali.me"
}
